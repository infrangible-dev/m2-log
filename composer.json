{
    "name": "infrangible/m2-log",
    "description": "Technical helper that lets Infrangible modules write log messages to several log files at once.",
    "type": "magento2-module",
    "version": "3.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Developer tools"
    ],
    "homepage": "https://www.infrangible.dev/modules/log",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "psr/log": "~2.0.0||~3.0.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\Log\\": "src"
        }
    }
}
